# ─── Supabase ───────────────────────────────────────────────
# Required. Set real values in .env.local and Netlify dashboard.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Legacy aliases bridged in next.config.mjs (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_DATABASE_URL)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_DATABASE_URL=https://your-ref.supabase.co

# ─── Mock Auth (dev/e2e only) ───────────────────────────────
# Password for the mock guest account (guest@example.com). Required in CI,
# optional locally (falls back to password123 for dev convenience).
# Set at least one of these:
NEXT_PUBLIC_MOCK_GUEST_PASSWORD=password123
MOCK_GUEST_PASSWORD=password123
MOCK_USER_PASSWORD=password123

# ─── App ────────────────────────────────────────────────────
# Canonical site URL for sitemap, OG metadata, and canonical links.
# In local dev: http://localhost:3000. In production: https://healthmadeclear.netlify.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Error Monitoring (optional) ───────────────────────────
# Sentry DSN for client-side error reporting (no PHI is sent).
# If not set, errors are logged to console only.
NEXT_PUBLIC_SENTRY_DSN=

# ─── Analytics (optional — configure before launch) ────────
# Google Analytics 4 measurement ID. If not set, analytics are no-ops.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Contact Form (optional) ───────────────────────────────
# Resend API key for sending contact form emails.
# If not set, submissions are stored in the contact_submissions Supabase table.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Email address to receive contact form submissions.
# CONTACT_EMAIL=hello@healthmadeclear.com

# ─── Distributed Rate Limiting (optional) ───────────────────
# Upstash Redis REST credentials. When both are set, contact/auth-callback
# rate limits are enforced via Upstash (survive serverless cold starts and
# scale across instances). If unset or unreachable, the in-memory limiter
# is used as a fallback so the endpoints stay available.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
